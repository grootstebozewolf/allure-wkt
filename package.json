{
  "name": "allure-wkt",
  "version": "0.2.0",
  "description": "Preprocessor for Allure: turns WKT geometry attachments into beautiful SVG visualizations that appear natively in the test's Attachments tab.",
  "type": "module",
  "bin": {
    "allure-wkt": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "allure",
    "wkt",
    "geometry",
    "svg",
    "preprocessor",
    "test-reporting"
  ],
  "author": "J.P.J. Bloemscheer / JeroenTechSolutions",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/grootstebozewolf/allure-wkt.git"
  },
  "bugs": {
    "url": "https://github.com/grootstebozewolf/allure-wkt/issues"
  },
  "homepage": "https://github.com/grootstebozewolf/allure-wkt#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
